{
  "name": "clicka-desktop",
  "version": "1.0.1",
  "description": "ClickA desktop app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:ui": "cd frontend-ui && npm run build",
    "dist:win": "npm run build:ui && electron-builder --win nsis",
    "dist:mac": "npm run build:ui && electron-builder --mac",
    "dist:linux": "npm run build:ui && electron-builder --linux"
  },
  "build": {
    "appId": "com.yourteam.clicka",
    "productName": "ClickA",
    "directories": {
      "output": "release"
    },
    "artifactName": "ClickA Setup ${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "frontend-ui/dist/**",
      "package.json",
      "!backend/**",
      "!.env",
      "!**/*.map"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "frontend-ui/src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClickA",
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "frontend-ui/src/assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "frontend-ui/src/assets/icon.png"
    },
    "extraResources": [
      {
        "from": "frontend-ui/src/assets/icon.ico",
        "to": "icons/icon.ico"
      }
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0"
  }
}
